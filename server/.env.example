# PostgreSQL connection string (pooled). Local example shown.
# On Supabase, use the transaction pooler (port 6543) + ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/studygroups?schema=public"

# Direct (non-pooled) connection used by Prisma for migrations.
# Local: mirror DATABASE_URL. On Supabase: use the session connection (port 5432).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/studygroups?schema=public"

# Secret used to sign JWT auth tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# How long issued tokens stay valid.
JWT_EXPIRES_IN="7d"

# Port the API listens on (local dev only; ignored by Vercel serverless).
PORT=4000

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGIN="http://localhost:3000"

# Optional: API key for the Anteater API (UCI course lookups). Works without one.
ANTEATER_API_KEY=""
